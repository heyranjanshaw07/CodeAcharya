# ==============================================================================
# CodeAcharya — Environment Variables Configuration
# ==============================================================================

# 1. BharatCode AI API Configuration
BHARATCODE_API_KEY=
BHARATCODE_BASE_URL=https://bharatcode.ai/api/model/v1
BHARATCODE_MODEL=qwen-3.8-27b

# 2. Legacy Gemini Configuration (Currently Unused)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 3. Authentication Secret
CODEACHARYA_AUTH_SECRET=REPLACE_WITH_SECURE_RANDOM_SECRET_MIN_32_CHARS

# 4. Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# 5. Database Configuration
CODEACHARYA_DB_PATH=codeacharya.db